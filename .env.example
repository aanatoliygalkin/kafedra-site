# Адрес проекта Supabase и открытый (anon) ключ доступа.
# Значения попадают в сборку клиентской части, поэтому секретный ключ
# service_role здесь указывать нельзя.
NEXT_PUBLIC_SUPABASE_URL=https://ваш-проект.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Путь размещения на GitHub Pages (имя репозитория). Для локальной сборки
# оставьте пустым.
NEXT_PUBLIC_BASE_PATH=
